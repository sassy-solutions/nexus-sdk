<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org only, no credentials. This SDK depends only on packages that are
       public on nuget.org — Microsoft.*, System.*, and Compendium.Abstractions.FeatureFlags — so `dotnet restore` works with zero auth
       for anyone consuming or contributing to this repo. The <clear /> makes the
       build independent of whatever feeds a developer has configured machine-wide. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
